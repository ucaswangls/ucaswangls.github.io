---
layout: default
---
{% include i18n.liquid %}
<div class="post">
  <section class="academic-hero" aria-label="{% if active_lang == 'en' %}Profile{% else %}个人信息{% endif %}">
    {% if page.profile.image %}
      <div class="profile hero-portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% assign profile_alt = site.first_name | append: ' ' | append: site.last_name %}
        {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded" sizes="190px" alt=profile_alt cache_bust=true %}
      </div>
    {% endif %}
    <header class="post-header hero-details">
      <h1 class="post-title">
        {% if active_lang == 'en' -%}
          Lishun Wang
        {%- else -%}
          王理顺 <span class="hero-name-en">Lishun Wang</span>
        {%- endif %}
      </h1>
      <p class="hero-position">{{ page.subtitle }}</p>
      {% if page.affiliation_detail %}
        <p class="hero-affiliation">{{ page.affiliation_detail }}</p>
      {% endif %}
      <p class="hero-email">
        {% if active_lang == 'en' %}Email{% else %}邮箱{% endif %}: <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
      {% if page.social %}
        <div class="social hero-social">
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
      {% endif %}
    </header>
  </section>
  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ home_url | append: 'publications/' | relative_url }}" style="color: inherit">{{ ui.publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="contact-note mt-4">{{ ui.contact }}</div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
